# Azure OpenAI. Copy to .env and fill in; .env is gitignored.
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# Deployment names, per role. These are Azure *deployment* names, which are
# chosen when the deployment is created and need not match the model id.
GANTRY_DEPLOYMENT_MAIN=gpt-4.1
GANTRY_DEPLOYMENT_FAST=gpt-4.1-mini

# Which provider the harness uses. "azure" needs the credentials above;
# "offline" is deterministic, free and needs nothing.
GANTRY_PROVIDER=offline

# Record and replay of provider traffic, so eval numbers stay reproducible
# and CI cannot spend money. off | read | record | replay
GANTRY_CACHE_MODE=off
GANTRY_CASSETTES=.gantry/cassettes

# Where traces and eval runs are stored.
GANTRY_DB=.gantry/gantry.db
GANTRY_ENV=local
GANTRY_LOG_LEVEL=info
